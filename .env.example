# Copy this file to .env and add your Google Maps API key.
# Enable these APIs in Google Cloud Console:
#   - Maps JavaScript API
#   - Geocoding API (for npm run geocode)
#
# Restrict the key by HTTP referrer for local dev, e.g. http://localhost:5173/*

VITE_GOOGLE_MAPS_API_KEY=your_api_key_here

# Map ID for Advanced Markers (Cloud Console → Map Management → Map IDs → Create)
VITE_GOOGLE_MAPS_MAP_ID=your_map_id_here

# Used by scripts/geocode.mjs — must NOT use HTTP referrer restriction (server-side).
# Create a separate key with Geocoding API only, or use /dev/geocode in the browser instead.
GOOGLE_GEOCODING_API_KEY=your_server_geocoding_key_here
GOOGLE_MAPS_API_KEY=your_api_key_here

# Logo.dev publishable key — https://www.logo.dev/dashboard/api-keys
VITE_LOGO_DEV_TOKEN=pk_your_logo_dev_key
VITE_USE_LOGO_DEV_MARKERS=true
